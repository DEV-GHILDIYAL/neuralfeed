# ---------- Frontend (exposed to browser — only public values) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------- Pipeline + /api/ask (server-side only — NEVER prefix with VITE_) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# AI providers — add whichever you have. Empty ones are skipped.
# If one fails / hits its rate limit, the next model/provider is used automatically.
GROQ_API_KEY=
GEMINI_API_KEY=          # also used for embeddings (duplicate check, related, Ask) — strongly recommended
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
AI_PROVIDER_ORDER=groq,gemini,openrouter,cerebras,mistral

# Optional model overrides — comma-separated, tried in order (defaults in pipeline/providers/index.js)
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# CEREBRAS_MODELS=gpt-oss-120b
# MISTRAL_MODELS=mistral-small-latest

# Pipeline tuning
MAX_ARTICLES_PER_RUN=20
ENABLE_HINDI=true          # translate every article to Hindi (1 extra AI call per article)
# DUP_SIMILARITY=0.8       # cosine similarity above which two stories count as the same
# FEED_MAX_AGE_HOURS=36

# Telegram auto-posting (optional) — see README
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=       # @yourchannel or -100xxxxxxxxxx
TELEGRAM_LANG=en           # en | hi

# Public site URL — used in Telegram links, canonical URLs, sitemap & RSS
SITE_URL=
